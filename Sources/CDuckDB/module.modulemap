// Exposes the DuckDB C API to Swift as `import CDuckDB`. The header comes from the
// official release fetched by scripts/fetch-duckdb.sh (DuckDB v2.0.0); the link flags
// live in Package.swift (DuckDBKit's linkerSettings).
module CDuckDB [system] {
    header "../../Vendor/duckdb/duckdb.h"
    export *
}
