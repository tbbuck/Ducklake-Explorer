<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the notarized, non-sandboxed build.

  disable-library-validation lets the hardened app dlopen DuckDB's own extensions, which
  DuckDB autoinstalls at runtime into Application Support. Those extensions are signed by
  DuckDB (ad-hoc / DuckDB's key), not by our Developer ID team, so library validation would
  otherwise refuse to load them. We can't bundle + re-sign them instead: a .duckdb_extension
  carries a metadata+signature footer after the Mach-O that Apple's notary rejects, and
  DuckDB confirms signing dynamically-loaded extensions is not currently possible
  (https://github.com/duckdb/duckdb/issues/16926). The app is not sandboxed, so file access
  and the outbound HTTPS used to fetch extensions need no further entitlement.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
